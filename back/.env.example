# ==============================================================================
# PalcoLivre - Configurações de Ambiente (.env)
# ==============================================================================

PORT=3333
NODE_ENV=development
API_URL=http://localhost:3333
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# BANCO DE DADOS: NEON (PostgreSQL)
# ------------------------------------------------------------------------------
# URL com pooling de conexão Neon (PgBouncer)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/palcolivre?sslmode=require"
# URL direta para migrations
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/palcolivre?sslmode=require"

# ------------------------------------------------------------------------------
# SEGURANÇA E CRIPTOGRAFIA
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_palcolivre_change_in_production_2026
JWT_EXPIRES_IN=7d
# Chave simétrica AES-256 de 32 bytes (64 caracteres hexadecimais) para dados sensíveis
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# STORAGE: CLOUDFLARE R2 (S3 Compatible API)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=palcolivre-media
R2_PUBLIC_URL=https://pub-yourbucketurl.r2.dev

# ------------------------------------------------------------------------------
# E-MAILS TRANSACIONAIS: MAILTRAP (SMTP)
# ------------------------------------------------------------------------------
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_user
MAILTRAP_PASS=your_mailtrap_pass
MAIL_FROM="PalcoLivre <nao-responda@palcolivre.com.br>"
