// PalcoLivre - Schema Prisma ORM
// Plataforma: A voz da música independente
// Database: PostgreSQL hospedado no Neon

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  LISTENER      // Usuário comum (ouvinte)
  BAND_MANAGER  // Gestor/integrante responsável pelo perfil de bandas
  ADMIN         // Administrador da plataforma
}

enum MusicGenre {
  ROCK
  INDIE
  METAL
  MPB
  POP
  PUNK
  HIP_HOP
  REGGAE
  BLUES
  ELECTRONIC
  OTHER
}

// -----------------------------------------------------------------------------
// USUÁRIOS E AUTENTICAÇÃO
// -----------------------------------------------------------------------------

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  passwordHash         String
  name                 String
  role                 UserRole      @default(LISTENER)
  avatarUrl            String?
  isVerified           Boolean       @default(false)
  verificationToken    String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relacionamentos
  bands                Band[]        @relation("UserManagedBands")
  bandLikes            BandLike[]
  albumLikes           AlbumLike[]
  trackLikes           TrackLike[]
  playlists            Playlist[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// BANDAS E PERFIS PÚBLICOS
// -----------------------------------------------------------------------------

model Band {
  id             String       @id @default(uuid())
  userId         String
  name           String
  slug           String       @unique
  genre          MusicGenre
  foundationYear Int
  bio            String       @db.Text
  members        String       @db.Text // Descritivo dos integrantes e instrumentos
  contactPhone   String       // Criptografado simetricamente (AES-256-GCM)
  contactEmail   String
  instagramUrl   String?
  spotifyUrl     String?
  youtubeUrl     String?
  profileImageUrl String?
  bannerImageUrl  String?
  viewCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relacionamentos
  manager        User         @relation("UserManagedBands", fields: [userId], references: [id], onDelete: Cascade)
  photos         BandPhoto[]
  albums         Album[]
  likes          BandLike[]

  // Índices para performance em buscas e vitrines globais
  @@index([genre])
  @@index([slug])
  @@index([viewCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("bands")
}

model BandPhoto {
  id        String   @id @default(uuid())
  bandId    String
  imageUrl  String   // URL no Cloudflare R2
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  band      Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@index([bandId])
  @@map("band_photos")
}

// -----------------------------------------------------------------------------
// ÁLBUNS E FAIXAS (MÚSICAS)
// -----------------------------------------------------------------------------

model Album {
  id            String     @id @default(uuid())
  bandId        String
  title         String
  coverImageUrl String     // URL da capa no Cloudflare R2
  releaseYear   Int
  genre         MusicGenre
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relacionamentos
  band          Band       @relation(fields: [bandId], references: [id], onDelete: Cascade)
  tracks        Track[]
  likes         AlbumLike[]

  // Índices para busca por gênero e vitrines de lançamentos
  @@index([bandId])
  @@index([genre])
  @@index([createdAt(sort: Desc)])
  @@map("albums")
}

model Track {
  id          String          @id @default(uuid())
  albumId     String
  title       String
  trackNumber Int             // De 1 a 10 (limite de 10 faixas por álbum)
  duration    Int             // Duração em segundos (ex: 215 = 3m35s)
  audioUrl    String          // URL pública ou CDN Cloudflare R2
  r2Key       String          // Chave do objeto no Cloudflare R2
  playCount   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relacionamentos
  album       Album           @relation(fields: [albumId], references: [id], onDelete: Cascade)
  playlistTracks PlaylistTrack[]
  likes       TrackLike[]

  // Garantia de ordem única por álbum e índice de popularidade
  @@unique([albumId, trackNumber])
  @@index([albumId])
  @@index([playCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("tracks")
}

// -----------------------------------------------------------------------------
// ENGAJAMENTO SOCIAL: CURTIDAS (LIKES)
// -----------------------------------------------------------------------------

model BandLike {
  id        String   @id @default(uuid())
  userId    String
  bandId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  band      Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@unique([userId, bandId])
  @@index([bandId])
  @@map("band_likes")
}

model AlbumLike {
  id        String   @id @default(uuid())
  userId    String
  albumId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@index([albumId])
  @@map("album_likes")
}

model TrackLike {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([trackId])
  @@map("track_likes")
}

// -----------------------------------------------------------------------------
// PLAYLISTS (EXCLUSIVO PARA USUÁRIOS LOGADOS)
// -----------------------------------------------------------------------------

model Playlist {
  id            String          @id @default(uuid())
  userId        String
  title         String
  description   String?
  coverImageUrl String?
  isPublic      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks        PlaylistTrack[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  order      Int      @default(0)
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@map("playlist_tracks")
}
