# ==============================================================================
# PalcoLivre - .gitignore
# ==============================================================================

# Dependências (Node.js)
node_modules/
*/node_modules/
.pnp
.pnp.js

# Builds de Produção
dist/
*/dist/
build/
*/build/
out/

# Variáveis de Ambiente e Segredos (NUNCA comitar .env)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
back/.env
front/.env
*.env
!*.env.example
!.env.example

# Logs e Depuração
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Arquivos do Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editores e IDEs
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testes e Cobertura
coverage/
.nyc_output/

# Cache e Arquivos Temporários
.eslintcache
.cache/
*.tsbuildinfo
